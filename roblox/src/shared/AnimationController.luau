--!strict
-- Thin wrapper around a Humanoid's Animator.
--
--   local controller = AnimationController.get(humanoid)   -- one shared controller per Humanoid
--   controller:playBase("walk", 0.2, 1.3)    -- the looping state layer (idle/walk/run/climb/...)
--   local track = controller:playAction("punch")             -- one-shots and held actions on top
--   controller:stopAction("block")
--
-- Priority and looping come from AnimationMeta (generated by the Blender pipeline), so the
-- clips behave the same way they were authored.

local AnimationLoader = require(script.Parent:WaitForChild("AnimationLoader"))
local AnimationMeta = require(script.Parent:WaitForChild("AnimationMeta"))

local AnimationController = {}
AnimationController.__index = AnimationController

export type AnimationController = typeof(setmetatable(
	{} :: {
		humanoid: Humanoid,
		animator: Animator,
		tracks: { [string]: AnimationTrack },
		baseName: string?,
		baseTrack: AnimationTrack?,
		destroyed: boolean,
	},
	AnimationController
))

local controllers: { [Humanoid]: AnimationController } = {}

local RunService = game:GetService("RunService")

local function findAnimator(humanoid: Humanoid): Animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end
	if RunService:IsClient() then
		-- The server creates the Animator. A client-made Animator would not replicate its tracks.
		return humanoid:WaitForChild("Animator") :: Animator
	end
	local newAnimator = Instance.new("Animator")
	newAnimator.Parent = humanoid
	return newAnimator
end

function AnimationController.new(humanoid: Humanoid): AnimationController
	local existing = controllers[humanoid]
	if existing then
		return existing
	end
	local self: AnimationController = setmetatable({
		humanoid = humanoid,
		animator = findAnimator(humanoid),
		tracks = {} :: { [string]: AnimationTrack },
		baseName = nil :: string?,
		baseTrack = nil :: AnimationTrack?,
		destroyed = false,
	}, AnimationController)
	controllers[humanoid] = self
	-- Old characters are not always destroyed (Workspace.PlayerCharacterDestroyBehavior), so also
	-- clean up when the Humanoid leaves the DataModel.
	humanoid.Destroying:Connect(function()
		self:destroy()
	end)
	humanoid.AncestryChanged:Connect(function()
		if not humanoid:IsDescendantOf(game) then
			self:destroy()
		end
	end)
	return self
end

-- Returns the controller for a Humanoid, waiting up to `timeout` seconds for another script to create it.
function AnimationController.get(humanoid: Humanoid, timeout: number?): AnimationController?
	local deadline = os.clock() + (timeout or 5)
	while controllers[humanoid] == nil and os.clock() < deadline do
		task.wait(0.05)
	end
	return controllers[humanoid]
end

function AnimationController.track(self: AnimationController, name: string): AnimationTrack?
	local existing = self.tracks[name]
	if existing then
		return existing
	end
	local animation = AnimationLoader.get(name)
	if animation == nil then
		return nil
	end
	local track = self.animator:LoadAnimation(animation)
	local meta = AnimationMeta[name]
	if meta then
		track.Priority = meta.priority
		track.Looped = meta.looped
	end
	self.tracks[name] = track
	return track
end

-- Switch the looping base layer. Calling it again with the same clip only adjusts the speed.
function AnimationController.playBase(self: AnimationController, name: string, fadeTime: number?, speed: number?): AnimationTrack?
	local fade = fadeTime or 0.2
	if self.baseName == name and self.baseTrack and self.baseTrack.IsPlaying then
		self.baseTrack:AdjustSpeed(speed or 1)
		return self.baseTrack
	end
	local track = self:track(name)
	if track == nil then
		return nil
	end
	if self.baseTrack and self.baseTrack ~= track then
		self.baseTrack:Stop(fade)
	end
	track:Play(fade, 1, speed or 1)
	self.baseName = name
	self.baseTrack = track
	return track
end

function AnimationController.setBaseSpeed(self: AnimationController, speed: number)
	if self.baseTrack then
		self.baseTrack:AdjustSpeed(speed)
	end
end

-- Play a one-shot (or held loop such as "block") on top of the base layer.
function AnimationController.playAction(self: AnimationController, name: string, fadeTime: number?, speed: number?): AnimationTrack?
	local track = self:track(name)
	if track == nil then
		return nil
	end
	track:Play(fadeTime or 0.1, 1, speed or 1)
	return track
end

function AnimationController.stopAction(self: AnimationController, name: string, fadeTime: number?)
	local track = self.tracks[name]
	if track and track.IsPlaying then
		track:Stop(fadeTime or 0.2)
	end
end

function AnimationController.isPlaying(self: AnimationController, name: string): boolean
	local track = self.tracks[name]
	return track ~= nil and track.IsPlaying
end

function AnimationController.stopAll(self: AnimationController, fadeTime: number?)
	for _, track in self.tracks do
		track:Stop(fadeTime or 0.2)
	end
	self.baseName = nil
	self.baseTrack = nil
end

function AnimationController.destroy(self: AnimationController)
	if self.destroyed then
		return
	end
	self.destroyed = true
	for _, track in self.tracks do
		track:Destroy()
	end
	table.clear(self.tracks)
	controllers[self.humanoid] = nil
end

return AnimationController
